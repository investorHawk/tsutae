# .env に写して値を入れる。.env はコミットしない。
# 有効にした行を空のままにすると既定値が効かない（`KEY=` は空の文字列として読まれる）。

# 変換と D4 に必須
ANTHROPIC_API_KEY=
# 医師画面のパスワード。空のままだと誰もログインできない
DOCTOR_PASSWORD=
# Cookie の署名鍵。空のままだと localhost 以外で起動が止まる
TSUTAE_SECRET=

# 毎日の通知を使うときだけ、3 つとも有効にする（値は scripts/gen_vapid.py で作る）
# TSUTAE_VAPID_PUBLIC_KEY=
# TSUTAE_VAPID_PRIVATE_KEY=
# TSUTAE_VAPID_SUBJECT=

# 任意。変えるときだけ行頭の # を外して値を入れる
# TSUTAE_DB=
# TSUTAE_TODAY=
# TSUTAE_DEMO_TOOLS=
# TSUTAE_PUBLIC_BASE_URL=
# TSUTAE_MODEL=
# TSUTAE_SUBAGENT_MODEL=
# TSUTAE_SKILLS_DIR=
# TSUTAE_REPORT_TTL_HOURS=
# TSUTAE_PIPELINE_TIMEOUT_S=
# TSUTAE_PIPELINE_MAX_TURNS=
# TSUTAE_PIPELINE_MAX_BUDGET_USD=
# TSUTAE_REGIMEN_TURN_TIMEOUT_S=
# TSUTAE_REGIMEN_MAX_TURNS=
# TSUTAE_REGIMEN_MAX_BUDGET_USD=
